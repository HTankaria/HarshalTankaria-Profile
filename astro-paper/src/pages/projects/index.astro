---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import config from "@/config";

const projects = await getCollection("projects");
---

<Layout
  title={`Projects | ${config.site.title}`}
  description="Technical projects focused on RF power systems and related domains."
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Projects">
    <p class="mb-8 opacity-80">
      A collection of technical projects — open-source code, simulations,
      hardware builds, and analysis tools — focused on RF power systems and
      related domains.
    </p>

    <ul class="space-y-8">
      {
        projects.map(project => (
          <li class="border-border border rounded-lg p-5">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <h2 class="text-xl font-semibold">{project.data.title}</h2>
              <span class="text-xs font-medium px-2 py-1 rounded-full bg-accent/10 text-accent whitespace-nowrap">
                {project.data.status}
              </span>
            </div>
            <p class="mt-2 opacity-80 text-sm leading-relaxed">
              {project.data.description}
            </p>
            {project.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {project.data.tags.map(tag => (
                  <span class="text-xs px-2 py-0.5 rounded border border-border opacity-60">
                    {tag}
                  </span>
                ))}
              </div>
            )}
            {project.data.links && (
              <div class="mt-3 flex gap-4 text-sm">
                {project.data.links.github && (
                  <a
                    href={project.data.links.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-accent underline decoration-dashed underline-offset-4"
                  >
                    GitHub
                  </a>
                )}
                {project.data.links.demo && (
                  <a
                    href={project.data.links.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-accent underline decoration-dashed underline-offset-4"
                  >
                    Demo
                  </a>
                )}
                {project.data.links.writeup && (
                  <a
                    href={project.data.links.writeup}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-accent underline decoration-dashed underline-offset-4"
                  >
                    Write-up
                  </a>
                )}
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
