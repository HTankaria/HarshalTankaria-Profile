---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import config from "@/config";

const talks = await getCollection("talks");
const sortedTalks = talks.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout
  title={`Talks | ${config.site.title}`}
  description="Selected presentations and talks on RF power systems, plasma engineering, and adjacent topics."
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Talks">
    <p class="mb-8 opacity-80">
      Selected presentations and talks on RF power systems, plasma engineering,
      and adjacent topics.
    </p>

    {
      sortedTalks.length === 0 ? (
        <p class="opacity-50 italic">Recent and upcoming talks will appear here.</p>
      ) : (
        <ul class="space-y-8">
          {sortedTalks.map(talk => (
            <li class="border-border border rounded-lg p-5">
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <h2 class="text-xl font-semibold">{talk.data.title}</h2>
                <span class="text-xs opacity-50 whitespace-nowrap">
                  {talk.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                  })}
                </span>
              </div>
              <p class="mt-1 text-sm opacity-60">{talk.data.venue}</p>
              {talk.data.abstract && (
                <p class="mt-2 text-sm opacity-80 leading-relaxed">
                  {talk.data.abstract}
                </p>
              )}
              {talk.data.link && (
                <div class="mt-3">
                  <a
                    href={talk.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm hover:text-accent underline decoration-dashed underline-offset-4"
                  >
                    Slides / Recording
                  </a>
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </Main>
  <Footer />
</Layout>
