---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import config from "@/config";
---

<Layout
  title={`Areas of Focus | ${config.site.title}`}
  description="Technical focus areas: high-power RF generator design, plasma RF delivery, matching networks, pulsed RF, embedded firmware, and NPI for semiconductor capital equipment."
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Areas of Focus" class="app-prose">
    <h2>High-Power RF Generator Design (350 kHz – 60 MHz, up to 10 kW)</h2>
    <p>
      Topology selection, gate drive design, and thermal and protection systems
      for generators driving plasma loads in semiconductor processing.
    </p>

    <h2>Plasma RF Delivery and Matching Networks</h2>
    <p>
      Frequency-tunable and variable-capacitor matching architectures, response
      time vs. range tradeoffs, and control loops tracking dynamic plasma
      impedances.
    </p>

    <h2>Pulsed RF and Process Control</h2>
    <p>
      Synchronous and asynchronous pulsing, multi-level pulse schemes, and the
      metrology challenges of measuring delivered power under pulsed operation.
    </p>

    <h2>Embedded Firmware for RF Systems</h2>
    <p>
      Real-time control on STM32 and Digi Rabbit platforms; coordinating RF
      sequencing, protection, and process telemetry.
    </p>

    <h2>New Product Introduction for Semiconductor Capital Equipment</h2>
    <p>
      Cross-functional execution from prototype to production, including design
      verification, manufacturing transfer, and field reliability.
    </p>
  </Main>
  <Footer />
</Layout>
